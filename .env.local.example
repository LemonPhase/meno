# GCP project used for Vertex AI (Application Default Credentials).
# gemini-3.5 models are served from the "global" endpoint — keep it global.
GCP_PROJECT_ID=
GCP_LOCATION=global

# Firebase web config - from Firebase console > Project settings.
# Public identifiers, not credentials, and inlined into the client bundle at
# build time. Only these two: they are all Firebase Auth reads (the other
# firebaseConfig fields configure Firestore, Storage and Analytics, and the
# browser talks to none of them). AUTH_DOMAIN is <project>.firebaseapp.com.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=

# Required locally for sign-in. firebase-admin picks credentials up
# automatically on Cloud Run (attached service account), but locally it needs
# a service account KEY FILE — `gcloud auth application-default login` gives
# you *user* credentials, which Identity Toolkit refuses for minting session
# cookies, so sign-in fails there while Firestore and Vertex keep working.
# Firebase console > Project settings > Service accounts > Generate new
# private key. Keep it outside the repo; it is a secret.
GOOGLE_APPLICATION_CREDENTIALS=

# Interface work without a Firebase Auth project: both halves together make
# "sign in" a click that names the uid "demoUser" — the Graph `npm run seed`
# fills — with no popup and no token verification. Never set in production;
# the server refuses to start with it. See ADR-0005.
# MENO_AUTH=scripted
# NEXT_PUBLIC_MENO_AUTH=scripted
