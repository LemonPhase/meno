# GCP project used for Vertex AI (Application Default Credentials).
# gemini-3.5 models are served from the "global" endpoint — keep it global.
GCP_PROJECT_ID=
GCP_LOCATION=global

# Firebase client config (public, safe to expose) - from Firebase console > Project settings
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# firebase-admin picks up credentials automatically on Cloud Run (attached service account)
# or via GOOGLE_APPLICATION_CREDENTIALS pointing at a service account key file locally.
GOOGLE_APPLICATION_CREDENTIALS=
